# Copy this file to .env for local development (never commit the real .env)

# Optional — enables AI-generated personalized health insights.
# Get a free key at https://ai.google.dev
GEMINI_API_KEY=

# Optional — only needed for persistent storage when deployed on Vercel.
# Without this, the app automatically falls back to a local SQLite file,
# which is perfect for local development but does NOT persist on Vercel's
# serverless filesystem. Get a free Postgres instance at https://neon.tech
# or https://supabase.com, then paste its connection string here.
DATABASE_URL=
