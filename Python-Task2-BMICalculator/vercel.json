{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["templates/**", "static/**", "app/**"]
      }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "main.py" },
    { "src": "/(.*)", "dest": "main.py" }
  ]
}
